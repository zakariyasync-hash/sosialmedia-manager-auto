# ==============================================================================
# AUTOSOCIAL 24/7 - BROWSER AUTOMATION & TELEGRAM CONFIGURATION
# ==============================================================================

PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

DATABASE_URL="file:./dev.db"
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 1. AKUN MEDIA SOSIAL (LOGIN BIASA / BROWSER AUTOMATION)
# ------------------------------------------------------------------------------
# Instagram Account
IG_USERNAME="username_ig_anda"
IG_PASSWORD="password_ig_anda"

# Facebook Account
FB_EMAIL="email_fb_anda@gmail.com"
FB_PASSWORD="password_fb_anda"

# X (Twitter) Account
X_USERNAME="username_atau_email_x_anda"
X_PASSWORD="password_x_anda"

# Mode Browser (true = berjalan di background tanpa jendela, false = jendela browser muncul)
HEADLESS_BROWSER=true

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT SETTINGS (Laporan Bukti Otomatis ke HP Anda)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_or_group_id_here"

# ------------------------------------------------------------------------------
# 3. JADWAL SESI & RETENSI
# ------------------------------------------------------------------------------
SCHEDULE_SLOT_PAGI="07:00"
SCHEDULE_SLOT_SIANG="13:00"
SCHEDULE_SLOT_MALAM="18:00"

CONTENT_RETENTION_DAYS=7
ALLOW_SIMULATION_FALLBACK=true
