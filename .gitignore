# Dependencies
node_modules/
dist/
build/
*.tsbuildinfo

# Environment & Secrets (Zero Leak Policy)
.env
.env.*
!.env.example
*.local

# Database & SQLite State
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal

# Sessions, Auth Tokens & Private Cookies
storage/sessions/*.json
!storage/sessions/.gitkeep

# Runtime Screenshots & Failure Artifacts
storage/screenshots/*.png
storage/screenshots/*.jpg
storage/screenshots/*.jpeg
storage/screenshots/*.html
storage/screenshots/failures/*
!storage/screenshots/.gitkeep
!storage/screenshots/failures/.gitkeep

# Chrome CDP & Browser Profiles
storage/chrome_profile/*
storage/browser_profiles/*
!storage/chrome_profile/.gitkeep
!storage/browser_profiles/.gitkeep

# Scratch & Temporary Folders
scratch/
tmp/
temp/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
